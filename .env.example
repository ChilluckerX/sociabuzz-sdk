# ─────────────────────────────────────────────────────────────
# SociaBuzz Payment Gateway — Environment Configuration
# ─────────────────────────────────────────────────────────────

# ── SociaBuzz backend ─────────────────────────────────────────
SOCIABUZZ_BASE_URL=https://sociabuzz.com

# Creator username used when a request omits "username".
# Set this to YOUR SociaBuzz creator account.
DEFAULT_CREATOR=yourcreatorusername

# ── Gateway server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Authentication (REQUIRED for production) ──────────────────
# Generate a strong random key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, auth is DISABLED (dev only — never deploy without it!).
API_KEY=
# Optional: comma-separated extra keys for rotation.
API_KEYS=

# ── Session persistence ───────────────────────────────────────
# sqlite  = file-based, survives restarts, multi-worker safe (default)
# memory  = in-memory only, single process, lost on restart (dev)
SESSION_BACKEND=sqlite
SESSION_DB_PATH=sociabuzz_sessions.db

# ── Webhook / callback ────────────────────────────────────────
# When a donor passes "callback_url" in POST /api/donate, the gateway
# polls SociaBuzz and POSTs the result to that URL.
WEBHOOK_ENABLED=true
WEBHOOK_POLL_INTERVAL=5
WEBHOOK_TIMEOUT=3600
# Optional shared secret sent as X-Webhook-Secret + HMAC X-Webhook-Signature
WEBHOOK_SECRET=
